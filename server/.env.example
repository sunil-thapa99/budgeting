# Get a key at https://build.nvidia.com  (login -> any model -> "Get API Key")
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA build API (OpenAI-compatible). Change models here if you want.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
INSIGHTS_MODEL=meta/llama-3.3-70b-instruct
VISION_MODEL=meta/llama-3.2-90b-vision-instruct
CATEGORIZE_MODEL=meta/llama-3.1-8b-instruct

PORT=5174

# CORS lockdown (production): comma-separated allowed frontend origins. Leave unset in dev.
# CORS_ORIGINS=https://your-frontend.vercel.app

# Supabase (see DB/README.md for where to copy each of these)
# Postgres connection string — use the Session/Transaction pooler URI + your DB password.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — SECRET, backend only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
